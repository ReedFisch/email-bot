# Email Service Configuration
# This file shows you what environment variables you need to set.
# Copy this file to .env and fill in your actual credentials.

# Email service provider (gmail, outlook, yahoo, etc.)
EMAIL_SERVICE=gmail

# Your email address
EMAIL_USER=your-email@gmail.com

# Your email password or app-specific password
# For Gmail: Use an App Password (https://support.google.com/accounts/answer/185833)
# For Outlook: Use your regular password or app password
EMAIL_PASSWORD=your-app-password-here

# Name that appears in "From" field (optional)
EMAIL_FROM_NAME=Email Bot

# Server port (optional, defaults to 3000)
PORT=3000
